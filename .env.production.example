# Appens publika adress — asynka motorer (Higgsfield X-Webhook-URL, fal.ai) POST:ar
# sina webhooks till <CANVAS_PUBLIC_URL>/api/engine-callback. Måste nås utifrån.
CANVAS_PUBLIC_URL=https://<canvas-host>
# Lämna CANVAS_LOCAL_* OSATTA i prod — då används Supabase Storage + Realtime rakt av.
