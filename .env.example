# Zaitex os (Supabase). Anon-nyckeln är publik klientnyckel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Verb-nyckeln gatar alla skrivningar (cv_*-verben). Hämtas som postgres:
#   select value from canvas.app_config where key='verb_key';
CANVAS_VERB_KEY=<verb-key>
# Appens publika adress — asynka motorer POST:ar sina webhooks till
# <CANVAS_PUBLIC_URL>/api/engine-callback. Default: http://localhost:3000
CANVAS_PUBLIC_URL=http://localhost:3000
# Riktiga motorn nano-banana (Googles Gemini-bildmodeller). Nyckeln ligger i
# Supabase Vault (name='gemini_api_key') — hämta som postgres, ALDRIG i repot.
GEMINI_API_KEY=<gemini-api-nyckel>
# Valfri modell-override (default gemini-2.5-flash-image)
# NANO_BANANA_MODEL=gemini-3.1-flash-image
